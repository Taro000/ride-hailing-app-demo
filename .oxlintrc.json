{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "unicorn", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["docs/**", ".claude/**", "apps/web-passenger/dist/**", "test-results/**", "playwright-report/**"],
  "rules": {
    "react/react-in-jsx-scope": "off"
  }
}
